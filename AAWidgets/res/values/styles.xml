<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light" />
    <style name="LargeTextStyle">
        <item name="android:textColor">@color/op_control_text_color_primary_dark</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:shadowColor">#26000000</item>
        <item name="android:shadowDy">4.0</item>
        <item name="android:shadowRadius">4.0</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
    <style name="OnePlus.TextAppearance.List.Summary" parent="@style/op_control_text_style_body1">
        <item name="android:textColor">@color/op_preference_subtitle_text_color</item>
    </style>
    <style name="OnePlus.TextAppearance.List.Title" parent="@style/op_control_text_style_h6">
        <item name="android:textColor">@color/op_preference_title_text_color</item>
    </style>
    <style name="TemperatureStyle">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:shadowColor">#26000000</item>
        <item name="android:shadowDy">4.0</item>
        <item name="android:shadowRadius">4.0</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
    <style name="TextAppearance.Compat.Notification" parent="@android:style/TextAppearance.Material.Notification" />
    <style name="TextAppearance.Compat.Notification.Info" parent="@android:style/TextAppearance.Material.Notification.Info" />
    <style name="TextAppearance.Compat.Notification.Info.Media" parent="@style/TextAppearance.Compat.Notification.Info" />
    <style name="TextAppearance.Compat.Notification.Line2" parent="@style/TextAppearance.Compat.Notification.Info" />
    <style name="TextAppearance.Compat.Notification.Line2.Media" parent="@style/TextAppearance.Compat.Notification.Info.Media" />
    <style name="TextAppearance.Compat.Notification.Media" parent="@style/TextAppearance.Compat.Notification" />
    <style name="TextAppearance.Compat.Notification.Time" parent="@android:style/TextAppearance.Material.Notification.Time" />
    <style name="TextAppearance.Compat.Notification.Time.Media" parent="@style/TextAppearance.Compat.Notification.Time" />
    <style name="TextAppearance.Compat.Notification.Title" parent="@android:style/TextAppearance.Material.Notification.Title" />
    <style name="TextAppearance.Compat.Notification.Title.Media" parent="@style/TextAppearance.Compat.Notification.Title" />
    <style name="Widget.Compat.NotificationActionContainer" parent="">
        <item name="android:background">@drawable/notification_action_background</item>
    </style>
    <style name="Widget.Compat.NotificationActionText" parent="">
        <item name="android:textAppearance">?android:textAppearanceButton</item>
        <item name="android:textSize">@dimen/notification_action_text_size</item>
        <item name="android:textColor">@color/secondary_text_default_material_light</item>
    </style>
    <style name="Widget.Support.CoordinatorLayout" parent="@android:style/Widget">
        <item name="statusBarBackground">#ff000000</item>
    </style>
    <style name="op_control_text_style_base">
        <item name="android:breakStrategy">simple</item>
    </style>
    <style name="op_control_text_style_body1" parent="@style/op_control_text_style_base">
        <item name="android:textSize">@dimen/op_text_size_body1</item>
        <item name="android:fontFamily">@string/op_control_font_text_body1</item>
    </style>
    <style name="op_control_text_style_button" parent="@style/op_control_text_style_base">
        <item name="android:textSize">@dimen/op_text_size_button</item>
        <item name="android:fontFamily">@string/op_control_font_text_button</item>
    </style>
    <style name="op_control_text_style_descriptions" parent="@style/op_control_text_style_base">
        <item name="android:textSize">@dimen/op_text_size_descriptions</item>
        <item name="android:fontFamily">@string/op_control_font_text_descriptions</item>
    </style>
    <style name="op_control_text_style_h1" parent="@style/op_control_text_style_base">
        <item name="android:textSize">@dimen/op_text_size_h1</item>
        <item name="android:lineSpacingMultiplier">@dimen/op_line_space_multiplier_h2</item>
        <item name="android:fontFamily">@string/op_control_font_display_h1</item>
    </style>
    <style name="op_control_text_style_h2" parent="@style/op_control_text_style_base">
        <item name="android:textSize">@dimen/op_text_size_h2</item>
        <item name="android:lineSpacingMultiplier">@dimen/op_line_space_multiplier_h2</item>
        <item name="android:fontFamily">@string/op_control_font_display_h2</item>
    </style>
    <style name="op_control_text_style_h3" parent="@style/op_control_text_style_base">
        <item name="android:textSize">@dimen/op_text_size_h3</item>
        <item name="android:fontFamily">@string/op_control_font_display_h3</item>
    </style>
    <style name="op_control_text_style_h4" parent="@style/op_control_text_style_base">
        <item name="android:textSize">@dimen/op_text_size_h4</item>
        <item name="android:fontFamily">@string/op_control_font_text_h4</item>
    </style>
    <style name="op_control_text_style_h5" parent="@style/op_control_text_style_base">
        <item name="android:textSize">@dimen/op_text_size_h5</item>
        <item name="android:fontFamily">@string/op_control_font_text_h5</item>
    </style>
    <style name="op_control_text_style_h6" parent="@style/op_control_text_style_base">
        <item name="android:textSize">@dimen/op_text_size_h6</item>
        <item name="android:fontFamily">@string/op_control_font_text_h6</item>
    </style>
    <style name="op_control_text_style_subtitle" parent="@style/op_control_text_style_base">
        <item name="android:textSize">@dimen/op_text_size_subtitle</item>
        <item name="android:fontFamily">@string/op_control_font_text_subtitle</item>
    </style>
    <style name="shadowStyle">
        <item name="android:shadowColor">#26000000</item>
        <item name="android:shadowDy">4.0</item>
        <item name="android:shadowRadius">4.0</item>
    </style>
    <style name="shadowStyle_Slogan">
        <item name="android:layout_marginLeft">15.0px</item>
        <item name="android:layout_marginTop">15.0px</item>
        <item name="android:shadowColor">#26000000</item>
        <item name="android:shadowDy">4.0</item>
        <item name="android:shadowRadius">4.0</item>
    </style>
    <style name="shadowStyle_Small">
        <item name="android:layout_marginLeft">15.0px</item>
        <item name="android:layout_marginTop">15.0px</item>
        <item name="android:shadowColor">#26000000</item>
        <item name="android:shadowDy">4.0</item>
        <item name="android:shadowRadius">4.0</item>
    </style>
    <style name="shadowStyle_dateSmall">
        <item name="android:layout_marginLeft">15.0px</item>
        <item name="android:shadowColor">#26000000</item>
        <item name="android:shadowDy">4.0</item>
        <item name="android:shadowRadius">4.0</item>
    </style>
</resources>
