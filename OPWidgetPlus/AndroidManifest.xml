<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:compileSdkVersion="35" android:compileSdkVersionCodename="15" package="net.oneplus.widget" platformBuildVersionCode="35" platformBuildVersionName="15">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:maxSdkVersion="32" android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <queries>
        <package android:name="com.oneplus.deskclock"/>
        <package android:name="com.google.android.deskclock"/>
        <package android:name="com.android.deskclock"/>
        <package android:name="com.sec.android.app.clockpackage"/>
        <package android:name="com.coloros.alarmclock"/>
        <package android:name="com.oplus.alarmclock"/>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS"/>
        </intent>
    </queries>
    <application android:allowBackup="false" android:extractNativeLibs="false" android:icon="@mipmap/ic_opwidget" android:label="@string/app_name" android:supportsRtl="true" android:theme="@style/AppTheme">
        <activity android:exported="true" android:label="@string/op_settings_label" android:name="net.oneplus.widget.op.SettingsActivity" android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <receiver android:exported="true" android:label="@string/op_label_clock" android:name="net.oneplus.widget.op.ClockProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/clock_widget_provider"/>
        </receiver>
        <receiver android:exported="true" android:label="@string/op_label_weather" android:name="net.oneplus.widget.op.WeatherProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/weather_widget_provider"/>
        </receiver>
        <receiver android:exported="true" android:label="@string/op_label_weather_clock" android:name="net.oneplus.widget.op.WeatherClockProvider">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/weather_clock_widget_provider"/>
        </receiver>
        <receiver android:exported="true" android:name="net.oneplus.widget.op.OpReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.USER_PRESENT"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.DATE_CHANGED"/>
                <action android:name="android.intent.action.LOCALE_CHANGED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
